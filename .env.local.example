# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Neon Postgres ---
# Pooled connection (host contains "-pooler") — used by the runtime Prisma
# driver adapter (src/lib/db.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (unpooled) connection — used by `prisma migrate` (prisma.config.ts).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Neon Auth (Better Auth) ---
# Auth URL: Neon console → Auth → Project Info → "Auth URL".
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth"
# Secret for signing session cookies; must be >= 32 chars. Generate with:
#   openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET="your-32+-char-random-secret"
